{
  "name": "sunspot-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "db:setup": "prisma generate && prisma migrate dev --name phase_1_backend && node prisma/seed.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "csv-stringify": "^6.7.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.6.3",
    "multer": "^2.1.1",
    "pdfkit": "^0.18.0",
    "redis": "^6.0.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "prisma": "^6.19.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
