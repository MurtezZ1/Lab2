{
  "name": "sunspot-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "frontend:install": "npm install --prefix frontend",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "backend:install": "npm install --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "backend:setup": "npm run db:setup --prefix backend",
    "backend:seed": "npm run prisma:seed --prefix backend",
    "backend:check": "npm run check --prefix backend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "infra:start": "docker compose up -d mongodb redis",
    "infra:stop": "docker compose stop mongodb redis",
    "infra:logs": "docker compose logs -f mongodb redis",
    "db:generate": "npm run prisma:generate --prefix backend",
    "db:migrate": "npm run prisma:deploy --prefix backend",
    "db:seed": "npm run prisma:seed --prefix backend",
    "db:setup": "npm run backend:setup",
    "postinstall": "npm run prisma:generate --prefix backend"
  }
}
