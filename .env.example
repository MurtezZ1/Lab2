DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sunspot_electronic_shop?schema=public"
MONGO_URL="mongodb://localhost:27017/sunspot"
REDIS_URL="redis://localhost:6379"

NODE_ENV=development
PORT=5000
CLIENT_URL="http://localhost:3000"
VITE_API_URL="http://localhost:5000/api"
VITE_SOCKET_URL="http://localhost:5000"

JWT_ACCESS_SECRET="replace_with_a_long_access_secret"
JWT_REFRESH_SECRET="replace_with_a_long_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

ADMIN_EMAIL="admin@sunspot.com"
ADMIN_PASSWORD="AdminPassword123!"

STRIPE_SECRET_KEY="sk_test_replace_with_your_key"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_your_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_your_webhook_secret"
